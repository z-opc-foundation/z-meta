<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-meta</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>z-meta-core</artifactId>

    <name>z-meta :: core</name>
    <description>元数据平台核心：应用/租户/字典/API/私有配置的实体、MyBatis Mapper 与 Service，含 @BizModel 采集器</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-meta-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据源统一收口为 z-boot-datasource-starter（替代 mysql + mybatis-plus）。
             2026-09-29 groupId 由 com.zifang 换成 io.github.yuku123：com.zifang 那一格只存在于
             本机 ~/.m2（repo1 的 com/zifang 整棵树 404），clean-room 实测直接红在
             "Could not find artifact com.zifang:z-boot-datasource-starter:jar:1.0.0-SNAPSHOT"。
             版本不写字面：继承来的 z-boot-parent 1.1.0 按坐标供 ${z-boot.version}=1.1.0。
             jar 逐类比过：本仓唯一用到的 ModuleDataSourceTemplate 两边全限定名一致。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>

        <!-- README 主张自守卫（ReadmeClaimsTest）用。
             版本不写字面：沿用 z-boot-parent 的 ${spring-boot.version} 地板（2.7.18 → JUnit Jupiter 5.8.2），
             与本仓「模块 POM 里不应再出现字面版本钉」的口径一致。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>