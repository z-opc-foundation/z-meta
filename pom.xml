<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径，试点是 z-cache）：继承第三方地板
         z-boot-dependencies:1.0.19（156 条）+ import 兄弟仓版本权威 z-boot-fleet:1.0.0（163 条）
         + 下发 Java 8 的 pluginManagement。
         迁移前这里的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT + <relativePath>../pom.xml</relativePath>，
         而 ORG 根**没有 pom.xml**（实测 `ls /Users/zifang/workplace/ceo_workplace/z-opc-foundation/pom.xml`
         = No such file），所以那一条只在本机 ~/.m2 里存在（14 个 property / 179 条 DM /
         spring-boot-maven-plugin:2.7.18 的 pluginManagement 全是从它借的；它自己 <build><plugins> 里的
         compiler 3.13.0 被本仓那条 3.11.0 顶掉了，实测两侧构建日志都是 compiler:3.11.0:compile）
         ——换台机器连 pom 都读不动（repo1-only 实测：rc=1、0 次下载、FATAL Non-resolvable parent POM）。
         relativePath 必须留空：新 parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.2.3</version>
        <relativePath/>
    </parent>

    <!-- 这两行以前没有：groupId/version 都是从 com.zifang:z-opc:1.0.0-SNAPSHOT 那条 parent 继承的。
         换 parent 后继承来的就是 io.github.yuku123:z-boot-parent:1.0.19 ⇒ 不写字面自家的话，本仓坐标会变成
         io.github.yuku123:z-boot-parent 那一格，而 4 个子 pom 的 parent 全写死自家坐标，当场读不动。
         迁移那一轮只做"把隐式坐标改成显式、逐字同值"，groupId/版本都不动（换 namespace 记在迁移报告的
         "拒绝裁定"里）。2026-09-30 CEO 裁定"上到中央仓库"，这一刀现在做完：
           groupId com.zifang → io.github.yuku123（与本组织已发布的 26 个仓同一 namespace）
           版本 1.0.0-SNAPSHOT → 1.0.0（Central 不接受 SNAPSHOT；repo1 实测 z-meta /
             z-meta-api / z-meta-core / z-meta-web / z-meta-frontend 在两个 namespace 下全部 404
             ⇒ 1.0.0 是这些坐标的第一个号，不顶掉任何已发布件）
         Java 包名仍是 com.zifang.*：换的是 Maven 坐标，不是 namespace（同 z-cache/z-util 的口径）。
         连带改动：仓内所有自家坐标（根 dependencyManagement 那 6 格 + 各子 pom 的 parent 与
         sibling 依赖）一起换，org 内除 z-opc 单体副本外没有别的仓引用这几个构件（实测全仓 grep），
         所以这次翻转不影响任何已发布件的解析。 -->

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-meta</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 这一段元数据是迁移**逼出来的必需项**，不是装饰：上面加了 <parent> 之后常开 flatten(oss)
         会把父链的 <description>/<url>/<developers>/<scm> 原样抄进每一份发布 pom，实测回读
         z-meta-core/.flattened-pom.xml 拿到的是
           <description>z-opc-foundation 各仓的统一 parent：继承第三方地板 BOM…</description>（那是 z-boot-parent 自己）
           <url>https://github.com/z-opc-foundation/z-boot/z-boot-dependencies/z-boot-parent/z-meta/z-meta-core</url>
           <scm><connection>scm:git:https://github.com/z-opc-foundation/z-boot.git/z-boot-dependencies/…</connection>
         ——逐条都是把 parent 链拼进路径的假地址。旧 parent（com.zifang:z-opc）只供 name/description/licenses，
         没有 url/developers/scm，所以这一层以前根本不会被读到。写法照 z-mist/pom.xml:42-68（同一 org、
         url 与本仓 `git remote get-url origin` 实测一致）。 -->
    <name>z-meta :: root</name>
    <description>
        Z-Meta: 元数据管理平台。数据库元数据 + API 元数据集中管理，含数据源动态配置、
        业务模型注解采集（@BizModel/@BizField）与模块/租户/字典管理。
        Metadata Platform Aggregator
    </description>
    <url>https://github.com/z-opc-foundation/z-meta</url>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-meta.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-meta.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-meta</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-meta-api</module>
        <module>z-meta-core</module>
        <module>z-meta-web</module>
        <!-- z-meta-admin 已废弃: controllers + AutoConfiguration 全迁到 z-meta-web.
             保留 z-meta-admin 源码目录仅作历史参考, 不参与构建以避免 application.yml 污染 main-starter.
             如需 standalone admin, 请独立启动 z-meta-admin 并用 server.port=18086 覆盖. -->
        <!-- 前端 Vite/Node 不参与 Maven 发布：它的 dist 是拷进 z-meta-admin/src/main/resources/static
             （上面已废弃、不在 reactor），要这条模块只会让发布构建去 nodejs.org 下 node；
             提交在仓里的 static 资产（git ls-files 实测 10 个文件）不受影响。同做法见 z-config/pom.xml。 -->
        <!-- <module>_frontend</module> -->
    </modules>
    <properties>
        <!-- 迁移删掉的键（逐条按**坐标**对过 parent_preflight 第 2 节 + 两侧 dependency:tree 实测）：
               maven.compiler.source / maven.compiler.target / project.build.sourceEncoding
                   → 父链 z-boot-parent 的 properties 就是 8 / 8 / UTF-8，逐字同值（旧 parent 供的是
                     1.8/1.8/UTF-8，javac 眼里同一个口径），删键不改行为。
               druid.version=1.2.18
                   → **死键**：全仓 0 处 <version> 引用它（根 pom 里 ${...} 只有 compile.version /
                     project.version / spring-boot.version 三个），基线 tree 实测 druid 与
                     druid-spring-boot-starter 都是 1.2.23（旧 parent import 的地板 1.0.18 给的字面值），
                     新链地板同样是 1.2.23 ⇒ 删键零漂移；反过来若照 preflight 的"不同值"提示补一条
                     1.2.18 的直接条目，就是把 1.2.23 降到 1.2.18（z-mist 同一格同一判法）。
               spring-boot-dependencies 的 <scope>import</scope>（连带它唯一的引用点 ${spring-boot.version}）
                   → 地板自己 import 同一坐标同一版本 2.7.18，本仓再 import 一遍只是 dm 打架的来源；
                     ⚠ 删这条 import 会连带删掉 Boot 那 14 条受管项自带的 <exclusions>，本仓 tree 里
                     命中的只有 mysql-connector-j 一条，已在下面按坐标整条补回（见那条注释）。

             必须留着的一类：
               compile.version=17 —— 父链根本不供这个键名（preflight 归到"父链没供给、必须自己留着"），
                     本仓 compiler 的 <source>/<target> 引用它；z-config/z-rpc 迁移后同样留着这一格。 -->
        <compile.version>17</compile.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- 本仓 5 个 reactor 坐标钉 ${project.version}（z-boot README「消费模型」步骤 4 / 验收判据 2）。
                 继承来的 DM 会改写**传递依赖**的版本，而 z-boot-fleet 里根本没有 z-meta 这一格（实测
                 `grep -c z-meta z-boot/z-boot-fleet/pom.xml` = 0），所以今天看不出差别，写上才是把话说死：
                 下次 fleet 收进 z-meta 的旧发布件时，本仓的 tree 与打包不会被它改写。
                 聚合 pom（z-meta / z-meta-frontend）必须带 <type>pom</type>：受管项按 g:a:type:classifier
                 匹配，不带 type 的条目挂在根本不存在的 jar 坐标上（z-mist 同一处实测）。
                 z-meta-api / z-meta-core 两条迁移前就在，逐字未动。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta-frontend</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>

            <!-- com.zifang:z-boot-*-starter 这两条 DM 格 2026-09-29 删掉，模块侧 groupId 换成
                 io.github.yuku123、版本交给继承来的 z-boot-parent 下发。
                 迁移那一轮这里记的是"逐字保留、不动"，理由是换坐标＝把本地 1.0.0-SNAPSHOT 快照换成
                 发布件（实现换血），超出"统一继承 parent"那一刀的范围 —— 理由当时成立，但它把
                 "这两件在 repo1 上永远 404"这笔账留在了盘上：clean-room 实测
                 Could not find artifact com.zifang:z-boot-datasource-starter:jar:1.0.0-SNAPSHOT，
                 z-meta-core 起不来，也就是 z-meta 到今天只能在本机构建。
                 这次换坐标前先比过实现：1.0.21 发布件与旧快照的 class 集合只差
                 com.zifang.z.boot.datasource.starter.PageResult（那是 #8 PageResult 收编时从
                 starter 里拿掉的），而本仓对 com.zifang.z.boot.* 的 import 只有
                 MetaModuleDataSource 一处，两边全限定名一致 ⇒ 换过去不是换血，是补上那一刀没做完的账。 -->
            <!-- z-meta-admin 不在 <modules> 里（上面那段注释：只留源码目录，standalone 时单独构建），
                 所以它不进 tree、这一格在本仓的实测差异是 0；留着是因为旧 parent 的 DM 确实供它
                 （实测 phantom-dm 里 com.zifang:z-meta-admin = ${project.version}），而 `mvn -f z-meta-admin/pom.xml`
                 那条既有走法依赖它。删掉就是悄悄砍掉一条对外契约。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-meta-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ⚠ 两条与父链**不同值/不供给**的格，必须按坐标写直接条目（README「消费模型」步骤 5、10；
                 只写版本是整条替换，所以要连 exclusion 一起抄）。

                 1) snakeyaml：基线 tree 实测 org.yaml:snakeyaml:2.0（CVE-2022-1471 那一格），它来自旧 parent
                    的**直接** DM 条目（实测 phantom-dm.txt 里 org.yaml:snakeyaml:jar::2.0）；新链的地板
                    **根本没有 snakeyaml 这一条**（repo1 回读 z-boot-dependencies:1.0.19 pom，grep -c = 0），
                    于是只剩 Boot 2.7.18 的 1.30 ⇒ 不显式写就静默 2.0 → 1.30 降版本。钉 2.0（z-cache/z-gw 同一格）。
                 2) mysql-connector-j：基线 tree 实测 com.mysql:mysql-connector-j:8.0.33 且**整棵树没有
                    com.google.protobuf:protobuf-java**（93 个坐标里 0 命中）—— 那是 Boot 2.7.18 那条受管项
                    自带 <exclusion>protobuf-java</exclusion> 的结果。删掉本仓的 Boot BOM import 后，地板
                    自己的直接条目（8.4.0，无 exclusion）接管：既抬到 8.4.0 又把 protobuf-java:3.25.5
                    （地板面值）放进了 3 棵树。照抄 Boot 那条 exclusion + 留 8.0.33 才是零漂移
                    （写法与判据同 z-mist/pom.xml:181-199；根治在地板 1.0.20 待办）。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.0</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.google.protobuf</groupId>
                        <artifactId>protobuf-java</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- knife4j-openapi3-spring-boot-starter:4.1.0 这条本地直接条目删掉了（迁移前 4.1.0，
                 子 pom z-meta-web / z-meta-admin 那两处字面 <version>4.1.0</version> 一起删，trap 3）：
                 地板 repo1 发布件实测 com.github.xiaoymin:knife4j-openapi3-spring-boot-starter =
                 ${knife4j-openapi3.version} = 4.1.0，逐字同值 ⇒ 由父链下发，两侧 tree 都是 4.1.0。 -->
        </dependencies>
    </dependencyManagement>
    <dependencies/>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- 本仓钉 2.7.12 对父链的 ${spring-boot.version}=2.7.18 是**刻意不同值**，留着不动：
                         reactor 里没人调用它，但不在 <modules> 的 z-meta-admin 用它的 repackage
                         （versionless，版本只能从这条 pluginManagement 拿）。换插件版本不在这一刀里。 -->
                    <version>2.7.12</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 版本键名沿用父链的 maven-compiler-plugin.version（地板发布件 = 3.11.0，与本仓迁移前
                     写的字面量逐字相同；两侧日志都是 compiler:3.11.0:compile）。
                     <source>/<target> 继续写 ${compile.version}=17（父链不供那个键，见上面 properties 注释）。
                     ⚠ 父链那份 <configuration> 的 <compilerArgs>-parameters</compilerArgs> 是**合并**进来的，
                     这一层挡不住（z-gw 试点实测：MethodParameters 属性会变，major 仍是 52）⇒ 迁移后
                     本仓 class 的 major 逐根比过，见迁移报告。 -->
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${compile.version}</source>
                    <target>${compile.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <!-- 父链的 pluginManagement 只管 compiler/surefire/failsafe/jar/resources/spring-boot 六件，
                     deploy/versions 这两件不供 ⇒ 字面版本原样留着（迁移不改插件版本）。 -->
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.17.1</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
            <!-- 常开 flatten（不挂 profile）：z-boot-parent 自己那条 flatten 声明是
                 <inherited>false</inherited> + resolveCiFriendliesOnly，**不下发**给消费仓；而加了
                 <parent> 之后不 flatten 就等于把发布件的依赖含义挂在那条 repo1 parent 链上。
                 本仓中央上一件都没有（实测 repo1 ranged GET：io.github.yuku123 与 com.zifang 两个 namespace
                 下 z-meta/z-meta-api/z-meta-core/z-meta-web/z-meta-frontend 全部 404）⇒ 没有"既有形状"
                 可对照，按 brief 取自包含 oss 那一支；版本写字面量 1.5.0（门禁机 Maven 3.6.0 实测只有
                 1.5.0 rc=0，1.6.0/1.7.x 要求 Maven 3.6.3+）。形状这件事记入"拒绝裁定"：真正对外发什么
                 形状由全组织那一批定。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- ═══════ 中央发布通道（2026-09-30 CEO 裁定「上到中央仓库」）═══════
         逐件抄 z-cache/pom.xml 的 central profile，插件版本面值一件不改：
         distributionManagement 指 https://central.sonatype.com（server id central 的凭据只在
         ~/.m2/settings.xml，值不落仓）；maven-deploy-plugin 3.1.4 skip=true，上传由
         central-publishing-maven-plugin 0.7.0 接管（tokenAuth + autoPublish + waitUntil=uploaded）；
         maven-source-plugin 3.3.0、maven-javadoc-plugin 3.11.2（doclint=none + failOnError=false）、
         maven-gpg-plugin 3.2.7（passphrase 只从 -Dgpg.passphrase 传，不写进 pom 也不写进命令行历史）。
         发布用 pom 的自包含由上面常开的 flatten(oss) + updatePomFile 负责。 -->
    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <!-- Java 口径由 parent 的 pluginManagement 下发（z-cache 这里原先引的是
                                 本仓没定义过的 compile.version，配 failOnError=false 后静默变成无效参数） -->
                            <source>${maven.compiler.source}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- 本插件不认 maven.deploy.skip，没排除的模块照样进 bundle
                                 （实测结论见 z-schedule/pom.xml 同位置注释）⇒ 不可发布的模块点名列出。
                              · 前端打包聚合器（packaging=pom + frontend-maven-plugin）：产物只是把 dist 复制进
                                  对应 -web 模块的中间步骤，不是任何别仓可引的构件。目录名是 _frontend，
                                  而 excludeArtifacts 按 artifactId 匹配 ⇒ 写的是 z-meta-frontend。 -->
                            <excludeArtifacts>
                                <excludeArtifact>z-meta-frontend</excludeArtifact>
                            </excludeArtifacts>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 真发前的形状检查：同一套 distributionManagement，只跳 javadoc 与签名。
             与 central 一起开（-Pcentral,central-dryrun）时后者的 properties 覆盖 skip 两格。 -->
        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>