<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-meta</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-meta-web</artifactId>

    <name>z-meta-web</name>
    <description>业务模型可视化中心 - web 模块：DictController + MetaApplicationController + MetaTenantController +
        ApiController + PrivateConfigController + BizModelController + HealthController (供 main-starter embed)
    </description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-meta-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>
        <!-- 2026-09-29 两格 groupId 由 com.zifang 换成 io.github.yuku123：com.zifang 那两条只存在于
             本机 ~/.m2（repo1 的 com/zifang 树 404），clean-room 里 z-meta-core 先红，这一格跟着红。
             版本不写字面，由继承来的 z-boot-parent 1.0.21 的 ${z-boot.version} 下发；
             jar 类集与旧 1.0.0-SNAPSHOT 快照逐类比过（本仓对 com.zifang.z.boot.* 的 import 只有
             MetaModuleDataSource 的 ModuleDataSourceTemplate，两坐标同名）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <!-- 2026-09-29 迁移：这里原先写死 <version>4.1.0</version>。模块 pom 里的字面 version 顶过
             所有 DM（README「消费模型」trap 3），删掉改由父链下发——地板发布件的面值实测同为 4.1.0，
             两侧 tree 逐字同值，这一刀不改版本。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

</project>